{
  "name": "hastabazaar-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:babal": "node scripts/build-babal.mjs",
    "package:babal:ci": "node scripts/package-babal-ci.mjs",
    "schema:babal": "node scripts/generate-mariadb-schema.mjs",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:returns": "tsx --test tests/returns-complaints.test.ts",
    "staging:verify": "tsx scripts/staging/verify-environment.mjs",
    "staging:forms:check": "tsx scripts/staging/form-preview-readiness.mjs",
    "staging:seed": "tsx scripts/staging/seed-fictional-fixtures.mjs",
    "staging:demo": "tsx scripts/staging/run-managed-maker-demo.mjs",
    "staging:reset": "tsx scripts/staging/reset-disposable-data.mjs",
    "lint": "oxlint --disable-nested-config app components lib db hooks tests scripts middleware.ts vite.config.ts next.config.ts drizzle.config.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@remotemerge/nepali-date-converter": "1.2.5",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "jose": "^6.1.3",
    "leaflet": "^1.9.4",
    "lucide-react": "1.31.0",
    "mysql2": "^3.15.3",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "sharp": "0.35.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "22.19.19",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "^0.31.10",
    "jsqr": "1.4.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "tailwindcss": "4.2.1",
    "tar": "7.5.22",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "type": "module"
}
